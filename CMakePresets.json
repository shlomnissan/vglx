{
  "version": 3,
  "configurePresets": [
    {
      "name": "development",
      "binaryDir": "${sourceDir}/build/development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "development-release",
      "inherits": "development",
      "binaryDir": "${sourceDir}/build/development-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "install",
      "binaryDir": "${sourceDir}/out/install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VGLX_BUILD_EXAMPLES": "OFF",
        "VGLX_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "benchmark",
      "binaryDir": "${sourceDir}/build/benchmark",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VGLX_BUILD_EXAMPLES": "OFF",
        "VGLX_BUILD_TESTS": "OFF",
        "VGLX_BUILD_BENCHMARKS": "ON"
      }
    }
  ]
}
